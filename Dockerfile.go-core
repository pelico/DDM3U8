# Go + uTLS 版下载器 Dockerfile
# 关键设计：builder 阶段钉在 BUILDPLATFORM，Go 原生交叉编译（不走 QEMU，快），
# 产出静态二进制；runtime 阶段只需 alpine + ffmpeg。
# 支持构建 linux/amd64、linux/arm64、linux/arm/v7 三架构。

#--------- builder：始终在构建机原生架构跑，Go 交叉编译到目标架构 ---------
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

# buildx 自动注入：BUILDPLATFORM/TARGETOS/TARGETARCH/TARGETVARIANT
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG TARGETVARIANT

WORKDIR /src

# 先拷依赖，利用层缓存
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO_ENABLED=0 → 静态二进制；GOARM 仅对 GOARCH=arm 生效（其它架构自动忽略）
RUN case "$TARGETARCH" in \
      arm) export GOARM=${TARGETVARIANT#v} ;; \
    esac && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/ddm3u8-go ./cmd/ddm3u8-go

#--------- runtime：alpine + ffmpeg + 静态二进制 ---------
FROM alpine:3.20

ENV TZ=Asia/Shanghai

RUN apk add --no-cache ffmpeg tini tzdata ca-certificates

COPY --from=builder /out/ddm3u8-go /usr/local/bin/ddm3u8-go

WORKDIR /downloads
VOLUME ["/downloads"]

ENTRYPOINT ["/sbin/tini", "--", "ddm3u8-go"]
